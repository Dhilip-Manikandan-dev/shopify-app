<div
  class="smart-shipping-container"
  data-smart-shipping-bar
  style="display:none;"
>
  <div class="smart-shipping-text">
    Calculating shipping perks...
  </div>
  <div class="smart-shipping-track">
    <div class="smart-shipping-fill" style="width: 0%;"></div>
  </div>
</div>

{{ 'smart-offer-rules.css' | asset_url | stylesheet_tag }}
<script src="{{ 'smart-offer-rules.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Free Shipping Progress",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Progress Bar Heading",
      "default": "Free Shipping Goal"
    }
  ]
}
{% endschema %}
