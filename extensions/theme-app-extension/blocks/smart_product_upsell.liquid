<div
  class="smart-offer-rules-block"
  data-smart-offer-block="product"
>
  <div data-smart-upsell-container data-surface="PRODUCT" class="smart-upsell-wrapper" style="display:none;"></div>
</div>

{% if customer %}
  <script>
    window.__SMART_OFFER_CUSTOMER__ = {
      tags: {{ customer.tags | json }},
      orderCount: {{ customer.orders_count | default: 0 }},
      lifetimeSpend: {{ customer.total_spent | divided_by: 100.0 | default: 0.0 }},
      country: {{ customer.default_address.country_code | json | default: '"IN"' }}
    };
  </script>
{% endif %}

{% if product %}
  <script>
    window.__SMART_OFFER_PRODUCT__ = {
      id: {{ product.id | json }},
      vendor: {{ product.vendor | json }},
      productType: {{ product.type | json }},
      tags: {{ product.tags | json }},
      collectionIds: [{% for c in product.collections %}{{ c.id | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
    };
  </script>
{% endif %}

{{ 'smart-offer-rules.css' | asset_url | stylesheet_tag }}
<script src="{{ 'smart-offer-rules.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Smart Product Upsell",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Block Heading",
      "default": "Frequently Bought Together"
    }
  ]
}
{% endschema %}
