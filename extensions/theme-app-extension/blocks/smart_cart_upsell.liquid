<div
  class="smart-offer-rules-block"
  data-smart-offer-block="cart"
>
  <div data-smart-upsell-container data-surface="CART" class="smart-upsell-wrapper" style="display:none;"></div>
</div>

{% if customer %}
  <script>
    window.__SMART_OFFER_CUSTOMER__ = {
      tags: {{ customer.tags | json }},
      orderCount: {{ customer.orders_count | default: 0 }},
      lifetimeSpend: {{ customer.total_spent | divided_by: 100.0 | default: 0.0 }},
      country: {{ customer.default_address.country_code | json | default: '"IN"' }}
    };
  </script>
{% endif %}

{{ 'smart-offer-rules.css' | asset_url | stylesheet_tag }}
<script src="{{ 'smart-offer-rules.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Smart Cart Upsell",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Block Heading",
      "default": "Add More & Save"
    }
  ]
}
{% endschema %}
