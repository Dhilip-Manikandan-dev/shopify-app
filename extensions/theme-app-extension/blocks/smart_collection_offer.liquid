<div
  class="smart-offer-rules-block"
  data-smart-offer-block="collection"
>
  <div data-smart-upsell-container data-surface="COLLECTION" class="smart-upsell-wrapper" style="display:none;"></div>
</div>

{{ 'smart-offer-rules.css' | asset_url | stylesheet_tag }}
<script src="{{ 'smart-offer-rules.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Smart Collection Offer",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Block Heading",
      "default": "Special Collection Deals"
    }
  ]
}
{% endschema %}
